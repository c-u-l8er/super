{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Cockpit",
  "version": "0.1.0",
  "identifier": "com.computedriven.super.cockpit",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Super (CD) — cockpit",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
